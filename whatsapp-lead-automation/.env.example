# ============================================================================
# Example Environment Variables Template (Rename to .env)
# ============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. Twilio WhatsApp Settings
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 3. Supabase Integration
# Must use the service_role key to bypass Row Level Security policies
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Optional Security Toggle for Local Testing
# Set to true to test the webhook manually using Postman, Curl, or other REST clients
SKIP_TWILIO_VALIDATION=false
